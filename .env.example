# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only: clave service_role para operaciones admin (insertar pagos, etc.)
# NUNCA exponer al cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===== Wompi (pasarela de pago) =====
# Public key del comercio. Se usa en el cliente (widget de pago).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=your_wompi_public_key_here
# Server-only: secreto de integridad para firmar la referencia del pago.
WOMPI_INTEGRITY_SECRET=your_wompi_integrity_secret_here
# Server-only: secreto de eventos para validar la firma del webhook de Wompi.
WOMPI_EVENT_SECRET=your_wompi_event_secret_here
